# BasicJobSummaryFlow

main: kit: flow: BasicJobSummaryFlow:
{
  entity: "job_summary",
  kind: "basic",
  name: "BasicJobSummaryFlow",
  step: [
    {
      i: {
        ref: "job_summary_ref01"
      }

      m: {
        job_id: "job01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "job_summary_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicJobSummaryFlow"
}