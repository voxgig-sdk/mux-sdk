  name: "BasicAnnotationFlow",
  step: [
    {
      i: {
        ref: "annotation_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "annotation_ref01",
        srcdatavar: "annotation_ref01_data",
        suffix: "_up0",
        textfield: "date"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-annotation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "annotation_ref01",
        srcdatavar: "annotation_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "annotation01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-annotation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "annotation_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "annotation01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicAnnotationFlow"
