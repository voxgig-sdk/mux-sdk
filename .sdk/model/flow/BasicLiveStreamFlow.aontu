        textfield: "active_asset_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-live_stream_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "live_stream_ref01",
        srcdatavar: "live_stream_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "live_stream01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-live_stream_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "live_stream_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "live_stream01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "live_stream_ref01"
          }
        }
      ]
    }
