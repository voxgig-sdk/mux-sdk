# BasicWebhookFlow

main: kit: flow: BasicWebhookFlow:
{
  entity: "webhook",
  kind: "basic",
  name: "BasicWebhookFlow",
  step: [
    {
      i: {
        ref: "webhook_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "webhook_ref01",
        srcdatavar: "webhook_ref01_data",
        suffix: "_up0",
        textfield: "address"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "webhook_ref01",
        srcdatavar: "webhook_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "webhook01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "webhook_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "webhook01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicWebhookFlow"
}