# Entity: asset_playback_id

main: kit: entity: asset_playback_id: {

  alias: field: {}

  fields: {
    drm_configuration_id: {
      h: "Drm Configuration Id"
      n: "drm_configuration_id"
      r: false
      sh: "The DRM configuration used by this playback ID."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the PlaybackID"
      t: "`$STRING`"
    }
    policy: {
      h: "Policy"
      n: "policy"
      r: true
      sh: "* `public` playback IDs are accessible by constructing an HLS URL like `https://stream.mux.com/${PLAYBACK_ID}` * `signed` playback IDs should be used with tokens `https://stream.mux.com/${PLAYBACK_ID}?token={TOKEN}`."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "asset_playback_id"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /video/v1/assets/{ASSET_ID}/playback-ids/{PLAYBACK_ID}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "asset_id"
                or: "ASSET_ID"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "PLAYBACK_ID"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/video/v1/assets/{ASSET_ID}/playback-ids/{PLAYBACK_ID}"
          q: {
            exist: [
              "asset_id"
              "id"
            ]
          }
          r: {
            param: {
              ASSET_ID: "asset_id"
              PLAYBACK_ID: "id"
            }
          }
          s: [
            {
              lit: "video"
            }
            {
              lit: "v1"
            }
            {
              lit: "assets"
            }
            {
              var: "asset_id"
            }
            {
              lit: "playback-ids"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.asset")]
  ]

}
