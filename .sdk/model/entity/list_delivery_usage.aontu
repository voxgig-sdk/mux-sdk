                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "timeframe"
                or: "timeframe[]"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/video/v1/delivery-usage"
          q: {
            exist: [
              "asset_id"
              "limit"
              "live_stream_id"
              "page"
              "timeframe"
            ]
          }
          s: [
            {
              lit: "video"
