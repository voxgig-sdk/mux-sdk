# Entity: list_webhook

main: kit: entity: list_webhook: {

  alias: field: {}

  fields: {
    address: {
      h: "Address"
      n: "address"
      r: true
      sh: "The URL where Mux sends webhook notifications."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "Time at which the webhook was created, as an ISO 8601 UTC datetime."
      t: "`$STRING`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether Mux attempts to deliver notifications to this webhook."
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the webhook."
      t: "`$STRING`"
    }
    signing_secret: {
      h: "Signing Secret"
      n: "signing_secret"
      r: false
      sh: "Secret used to verify that webhook payloads were sent by Mux."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "list_webhook"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /system/v1/webhooks"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 25
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/system/v1/webhooks"
          q: {
            exist: [
              "limit"
              "page"
            ]
          }
          s: [
            {
              lit: "system"
            }
            {
              lit: "v1"
            }
            {
              lit: "webhooks"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
